// NeoShop — Firestore Security Rules
// Firebase project: ecomerce-ai-20fee
//
// Manual validation checklist (Firebase Rules Playground):
//  1. Unauthenticated read of `products`              → DENIED
//  2. Authenticated read of `products/any-id`         → ALLOWED
//  3. Authenticated read of `carts/{own-uid}`         → ALLOWED
//  4. Authenticated read of `carts/{other-uid}`       → DENIED
//  5. Authenticated read of `orders/{id}` uid==auth   → ALLOWED
//  6. Authenticated read of `orders/{id}` uid!=auth   → DENIED
//  7. Authenticated create `orders/{id}` uid==auth    → ALLOWED
//  8. Authenticated update of `orders/{id}`           → DENIED
//  9. Authenticated read of `coupons/SAVE10`          → ALLOWED
// 10. Authenticated write to `coupons/SAVE10`         → DENIED

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Deny everything by default ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── users/{uid} ─────────────────────────────────────────────────────────
    // Owner-only read and write. Used by AuthController (register, Google
    // sign-in) and the profile/edit-profile screens.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── products/{id} ───────────────────────────────────────────────────────
    // Any authenticated user may read. No client writes — products are managed
    // via Firebase Console / Admin SDK only.
    match /products/{id} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── carts/{uid} ─────────────────────────────────────────────────────────
    // Owner-only read and write. CartController uses carts/{uid} as the
    // document path, so the path segment uid must match the authenticated uid.
    match /carts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── orders/{id} ─────────────────────────────────────────────────────────
    // Read:   owner only — checked against the uid field stored in the doc.
    // Create: owner only — uid in the new doc must match the authenticated uid.
    // Update/Delete: blocked from client — order status is admin-managed only.
    // Note: OrderController queries with .where('uid', isEqualTo: _uid);
    //       the read rule covers this because Firestore evaluates the rule
    //       per-document and the where clause filters to matching docs only.
    match /orders/{id} {
      allow read:   if request.auth != null
                    && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // ── coupons/{code} ──────────────────────────────────────────────────────
    // Any authenticated user may read (needed for coupon validation at
    // checkout). No client writes — coupons are managed via Firebase Console.
    match /coupons/{code} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
